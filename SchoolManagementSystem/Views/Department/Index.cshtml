@model IEnumerable<Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Departments</h2>
        <p class="text-muted">Manage school departments.</p>
    </div>

    <a asp-action="Add" class="btn btn-primary">+ Add Department</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Department Name</th>
                        <th>Students Count</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var department in Model)
                        {
                            <tr>
                                <td>@department.Id</td>
                                <td>@department.Name</td>
                                <td>@department.Students.Count</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@department.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>

                                    <a asp-action="Delete" asp-route-id="@department.Id"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">No departments found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
