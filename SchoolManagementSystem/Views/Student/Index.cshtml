cshtml
@model SchoolManagementSystem.ViewModels.StudentIndexViewModel

@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Students</h2>
        <p class="text-muted">Manage all registered students.</p>
    </div>

    <a asp-controller="Student"
       asp-action="Add"
       class="btn btn-primary">
        + Add Student
    </a>
</div>

<!-- Statistics -->
<div class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <p class="text-muted mb-1">Total Students</p>
                <h3>@Model.TotalStudents</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <p class="text-muted mb-1">Current Page</p>
                <h3>@Model.CurrentPage</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <p class="text-muted mb-1">Total Pages</p>
                <h3>@Model.TotalPages</h3>
            </div>
        </div>
    </div>

</div>

<!-- Search and Filter -->
<form asp-controller="Student"
      asp-action="Index"
      method="get"
      class="card card-body shadow-sm border-0 mb-4">

    <div class="row g-3 align-items-end">

        <div class="col-md-5">
            <label for="searchTerm" class="form-label">
                Search
            </label>

            <input type="text"
                   id="searchTerm"
                   name="searchTerm"
                   value="@(Model.SearchTerm ?? string.Empty)"
                   class="form-control"
                   placeholder="Search by student name or email..." />
        </div>

        <div class="col-md-4">
            <label for="departmentId" class="form-label">
                Department
            </label>

            <select id="departmentId"
                    name="departmentId"
                    class="form-select">

                <option value="">All Departments</option>

                @if (Model.Departments != null)
                {
                    @foreach (var department in Model.Departments)
                    {
                        if (Model.DepartmentId == department.Id)
                        {
                            <option value="@department.Id" selected>
                                @department.Name
                            </option>
                        }
                        else
                        {
                            <option value="@department.Id">
                                @department.Name
                            </option>
                        }
                    }
                }

            </select>
        </div>

        <div class="col-md-3 d-flex gap-2">

            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <a asp-controller="Student"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Reset
            </a>

        </div>

    </div>
</form>

<!-- Students Table -->
<div class="card shadow-sm border-0">
    <div class="card-body">

        <div class="table-responsive">
            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Age</th>
                        <th>Department</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Students != null && Model.Students.Any())
                    {
                        @foreach (var student in Model.Students)
                        {
                            <tr>
                                <td>@student.Id</td>

                                <td>@student.Name</td>

                                <td>@student.Email</td>

                                <td>@student.Age</td>

                                <td>
                                    @(student.Department?.Name ?? "Not Assigned")
                                </td>

                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">

                                        <a asp-controller="Student"
                                           asp-action="Details"
                                           asp-route-id="@student.Id"
                                           class="btn btn-sm btn-outline-info">
                                            Details
                                        </a>

                                        <a asp-controller="Student"
                                           asp-action="Edit"
                                           asp-route-id="@student.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-controller="Student"
                                           asp-action="Delete"
                                           asp-route-id="@student.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                No students found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Students pagination">
                <ul class="pagination justify-content-center mb-0">

                    <!-- Previous -->
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">

                        @if (Model.CurrentPage > 1)
                        {
                            <a class="page-link"
                               asp-controller="Student"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-departmentId="@Model.DepartmentId">
                                Previous
                            </a>
                        }
                        else
                        {
                            <span class="page-link">Previous</span>
                        }

                    </li>

                    ```cshtml
                    <!-- Page Numbers -->
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-controller="Student"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-departmentId="@Model.DepartmentId">
                                @i
                            </a>
                        </li>
                    }
                    


                    <!-- Next -->
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">

                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a class="page-link"
                               asp-controller="Student"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-departmentId="@Model.DepartmentId">
                                Next
                            </a>
                        }
                        else
                        {
                            <span class="page-link">Next</span>
                        }

                    </li>

                </ul>
            </nav>
        }

    </div>
</div>

